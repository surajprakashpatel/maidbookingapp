rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        getUserData().role == 'admin' ||
        request.auth.token.role == 'admin'
      );
    }

    function isMaid() {
      return isAuthenticated() && getUserData().role == 'maid';
    }

    function isCustomer() {
      return isAuthenticated() && getUserData().role == 'customer';
    }

    // 1. Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // 2. Customers collection
    match /customers/{customerId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(customerId) || isAdmin();
    }

    // 3. Maids collection
    match /maids/{maidId} {
      // Public / Customer can read approved active maids
      allow read: if true;
      
      // Maid can register their own record
      allow create: if isAuthenticated() && request.resource.data.approvalStatus == 'under_review';
      
      // Maid can update non-security fields (bio, pricing, availability)
      allow update: if isAdmin() || (
        isAuthenticated() && resource.data.userId == request.auth.uid &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['approvalStatus', 'verificationStatus', 'selfieStatus', 'aadhaarMasked'])
      );
      
      // Only Admin can delete or change approval/verification status
      allow delete: if isAdmin();
    }

    // 4. Bookings collection
    match /bookings/{bookingId} {
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.maidId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.customerId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.maidId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // 5. Payments collection
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // 6. Notifications collection
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // 7. Settings collection
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
